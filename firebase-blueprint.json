{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information and settings preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "units": { "type": "string", "enum": ["metric", "imperial"] },
        "mapStyle": { "type": "string", "enum": ["streets", "satellite"] },
        "language": { "type": "string", "enum": ["en", "ko"] }
      },
      "required": ["email"]
    },
    "RecentSearch": {
      "title": "RecentSearch",
      "description": "A recent location query searched by the user",
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["query", "timestamp"]
    },
    "SavedPlace": {
      "title": "SavedPlace",
      "description": "A place saved by the user on the map",
      "type": "object",
      "properties": {
        "placeId": { "type": "string" },
        "displayName": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "savedAt": { "type": "number" },
        "journalNotes": { "type": "string" },
        "journalImages": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["placeId", "displayName", "savedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat log between user and Gemini assistant",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "isUser": { "type": "boolean" },
        "timestamp": { "type": "number" },
        "imageUrl": { "type": "string" }
      },
      "required": ["text", "isUser", "timestamp"]
    },
    "TravelSnapshot": {
      "title": "TravelSnapshot",
      "description": "A short-form travel snapshot shared by a user to the feed",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "locationName": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "text", "locationName", "createdAt"]
    },
    "Itinerary": {
      "title": "Itinerary",
      "description": "A list of stops in a user's trip plan",
      "type": "object",
      "properties": {
        "stops": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "number" }
      },
      "required": ["stops", "updatedAt"]
    },
    "MemoryTrailPin": {
      "title": "MemoryTrailPin",
      "description": "A past location pin from the 24-hour memory trail",
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["lat", "lng", "timestamp"]
    },
    "PassportStamp": {
      "title": "PassportStamp",
      "description": "A digital stamp collected by visiting a landmark",
      "type": "object",
      "properties": {
        "landmarkId": { "type": "string" },
        "name": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["landmarkId", "name", "timestamp"]
    },
    "AtmosphereMood": {
      "title": "AtmosphereMood",
      "description": "Short location-tagged mood/vibe dropped by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "emoji": { "type": "string" },
        "text": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "text", "lat", "lng", "timestamp"]
    },
    "UserLocation": {
      "title": "UserLocation",
      "description": "Real-time location coordinates for a user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "lat", "lng", "updatedAt"]
    },
    "GroupTrip": {
      "title": "GroupTrip",
      "description": "A collaborative trip shared among multiple users",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "participantEmails": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" }
      },
      "required": ["ownerId", "name", "participantEmails", "createdAt"]
    },
    "Poll": {
      "title": "Poll",
      "description": "A group decision poll within a trip",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "votes": { "type": "object", "additionalProperties": { "type": "number" } },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["question", "options", "votes", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "users/{userId}/planner/active": {
      "schema": { "$ref": "Itinerary" },
      "description": "User's current active trip plan"
    },
    "users/{userId}/savedPlaces/{placeId}": {
      "schema": { "$ref": "SavedPlace" },
      "description": "User's saved places"
    },
    "users/{userId}/chatHistory/{messageId}": {
      "schema": { "$ref": "ChatMessage" },
      "description": "User's chat history with Gemini"
    },
    "users/{userId}/memoryTrail/{pinId}": {
      "schema": { "$ref": "MemoryTrailPin" },
      "description": "User's location pins for the Memory Trail"
    },
    "users/{userId}/recentSearches/{searchId}": {
      "schema": { "$ref": "RecentSearch" },
      "description": "User's recent location search queries"
    },
    "users/{userId}/passportStamps/{stampId}": {
      "schema": { "$ref": "PassportStamp" },
      "description": "User's collected digital passport stamps"
    },
    "atmosphereMoods/{moodId}": {
      "schema": { "$ref": "AtmosphereMood" },
      "description": "Global feed of short location moods"
    },
    "travelSnapshots/{snapshotId}": {
      "schema": { "$ref": "TravelSnapshot" },
      "description": "Shared travel snapshots feed"
    },
    "userLocations/{userId}": {
      "schema": { "$ref": "UserLocation" },
      "description": "Real-time user locations for social features"
    },
    "groupTrips/{tripId}": {
      "schema": { "$ref": "GroupTrip" },
      "description": "Shared group trip documents"
    },
    "groupTrips/{tripId}/snapshots/{snapshotId}": {
      "schema": { "$ref": "TravelSnapshot" },
      "description": "Snapshots specific to a group trip"
    },
    "groupTrips/{tripId}/polls/{pollId}": {
      "schema": { "$ref": "Poll" },
      "description": "Interactive polls within a group trip"
    },
    "_vanti_health/{id}": {
      "schema": { "type": "object", "properties": {} },
      "description": "System health check collection"
    }
  }
}
